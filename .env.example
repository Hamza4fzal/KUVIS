# Copy to .env and adjust. Never commit .env.

# PostgreSQL / PostGIS
KUVIS_DB_HOST=localhost
KUVIS_DB_PORT=5433
KUVIS_DB_NAME=kuvis
KUVIS_DB_USER=kuvis
KUVIS_DB_PASSWORD=change-me

# Backend
KUVIS_API_CORS_ORIGINS=http://localhost:5173

# Optional: Google Earth Engine (not required — the pipeline uses Planetary Computer STAC by default)
# EE_PROJECT=your-gcp-project-id

# Optional: Planetary Computer subscription key (raises rate limits; anonymous access works)
# PC_SDK_SUBSCRIPTION_KEY=

# Optional, not used unless the traffic extension is enabled
# TOMTOM_API_KEY=
